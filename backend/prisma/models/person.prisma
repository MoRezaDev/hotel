model Person {
    id String @id @default(uuid())

    firstName String?
    lastName String?
    firstNameEn String?
    lastNameEn String?
    gender Gender?
    mobileNumber String @unique
    nationality String?
    codeNational Int? @unique
    passportNumber Int? @unique
    passportExpireDate DateTime?
    birthday DateTime?
    image String?
    isVip Boolean @default(false)
    isBanned Boolean @default(false)
    role String @default("user")
    email String?
    password String?
    otp Otp?
    passengers Passenger[]
    orders Order[]

    comments Comment[]

    createdAt DateTime @default(now())
    updatedAt   DateTime @updatedAt


}
enum Gender {
    MAN
    WOMAN
}


model Otp {
    id String @id @default(uuid())
    code String
    expiresAt DateTime 

    personId String @unique
    person Person @relation(fields: [personId],references: [id],onDelete: Cascade)
}

model Comment {
    id String @id @default(uuid())

    text String
    userRating Int

    userId String
    user Person @relation(fields: [userId],references: [id],onDelete: Cascade)

    hotelId String
    hotel Hotel @relation(fields: [hotelId],references: [id],onDelete: Cascade)

    createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Passenger {
    id String @id @default(uuid())

    firstName String 
    lastName String
    codeNational Int @unique
    mobileNumber Int @unique
    gender Gender

    persons Person[]
    orders Order[]

    createdAt DateTime @default(now())
    updatedAt   DateTime @updatedAt



}

